# Copy to .env only if you want to change something — every value has a working default.

# Ports on your machine (defaults shown). In Jaah worktrees these are set by the pool — never hand-assign.
# DB_PORT=5432
# API_PORT=8000
# FRONTEND_PORT=5173

# Set by the pool in Jaah worktrees; defaults to "newstepsincoding" otherwise.
# COMPOSE_PROJECT_NAME=newstepsincoding

# "local" accepts the built-in development signing key. Any other value requires SESSION_SECRET.
APP_ENV=local

# Signs the login cookie. Leave blank for local development; for any real deployment set a long
# random value (openssl rand -hex 32) and store it as a secret, never in git.
SESSION_SECRET=

# Where the app is opened in the browser. An https:// URL marks the login cookie Secure.
# Derived from FRONTEND_PORT by ./dc when unset.
# FRONTEND_URL=http://localhost:5173
