# SITE_HOST is the public host name; Caddy obtains and renews its Let's Encrypt certificate itself.
{$SITE_HOST} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		# Client-side routes (/sky, /login, …) all load the single-page app.
		try_files {path} /index.html
		file_server
	}
}
